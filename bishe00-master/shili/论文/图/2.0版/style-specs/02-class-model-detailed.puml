@startuml
title NeonScan 2.0 主类图
top to bottom direction
hide empty members
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam packageStyle rectangle
package "任务管理" {
class "Task" as Task {
  - m: sync.Mutex
  + ID: string
  + Total: int
  + Done: int
  + Created: time.Time
  - ch: chan SSEMessage
  - stop: chan struct
  - stopped: bool
  --
  + IncDone(): tuple<int, int>
  + Send(msg: SSEMessage): bool
  + Close(): void
}
class "SSEMessage" as SSEMessage {
  + Type: string
  + TaskID: string
  + Progress: string
  + Percent: int
  + Data: any
}
}
package "扫描请求" {
class "PortScanReq" as PortScanReq {
  + Host: string
  + Ports: string
  + Concurrency: int
  + TimeoutMs: int
  + ScanType: string
  + GrabBanner: bool
}
class "DirScanReq" as DirScanReq {
  + BaseURL: string
  + DictPaths: List<string>
  + BuiltinDicts: List<string>
  + Concurrency: int
  + TimeoutMs: int
}
class "WebProbeReq" as WebProbeReq {
  + URLs: List<string>
  + Concurrency: int
  + TimeoutMs: int
  + Headers: map<string, string>
  + FollowRedirect: bool
  + FetchFavicon: bool
  + FetchRobots: bool
}
class "PocScanReq" as PocScanReq {
  + BaseURL: string
  + PocDir: string
  + PocPaths: List<string>
  + TimeoutMs: int
  + Concurrency: int
}
class "ExpExecReq" as ExpExecReq {
  + BaseURL: string
  + ExpDir: string
  + ExpPaths: List<string>
  + InlineExps: List<ExpSpec>
  + Concurrency: int
  + TimeoutMs: int
}
class "AIAnalyzeReq" as AIAnalyzeReq {
  + Provider: string
  + APIKey: string
  + BaseURL: string
  + Model: string
  + ReportData: map<string, any>
}
class "AIGenPythonFromExpReq" as AIGenPythonFromExpReq {
  + Provider: string
  + APIKey: string
  + BaseURL: string
  + Model: string
  + TargetBaseURL: string
  + TimeoutMs: int
  + Exp: ExpSpec
  + Verify: *ExpVerifyInfo
  + AutoVerify: bool
  + TargetURL: string
  + MaxRetries: int
}
class "AIGenPythonFromExpBatchReq" as AIGenPythonFromExpBatchReq {
  + Provider: string
  + APIKey: string
  + BaseURL: string
  + Model: string
  + TargetBaseURL: string
  + TimeoutMs: int
  + ExpDir: string
  + ExpPaths: List<string>
  + InlineExps: List<ExpSpec>
  + Concurrency: int
}
}
package "POC规则" {
class "POC" as POC {
  + Name: string
  + Method: string
  + Path: string
  + Body: string
  + Headers: map<string, string>
  + Match: string
}
class "XRPOC" as XRPOC {
  + ID: string
  + Info: XRInfo
  + Rules: map<string, XRRule>
  + Expression: string
}
class "XRInfo" as XRInfo {
  + Name: string
  + Author: string
  + Severity: string
  + Reference: List<string>
}
class "XRRule" as XRRule {
  + Request: XRRequest
  + Expression: string
}
class "XRRequest" as XRRequest {
  + Method: string
  + Path: string
  + Body: string
  + Headers: map<string, string>
}
class "NucleiPOC" as NucleiPOC {
  + ID: string
  + Info: NucleiInfo
  + Requests: List<NucleiRequest>
  + Matchers: List<NucleiMatcher>
  + MatchersCondition: string
  + MaxRedirects: int
}
class "NucleiInfo" as NucleiInfo {
  + Name: string
  + Author: string
  + Severity: string
  + Risk: string
  + Reference: List<string>
  + Description: string
  + Tags: List<string>
}
class "NucleiRequest" as NucleiRequest {
  + Method: string
  + Path: List<string>
  + Headers: any
  + Body: string
  + Matchers: List<NucleiMatcher>
}
class "NucleiMatcher" as NucleiMatcher {
  + Type: string
  + Part: string
  + Words: List<string>
  + Regex: List<string>
  + Condition: string
  + Status: List<int>
  + Dsl: List<string>
}
class "NucleiHeaders" as NucleiHeaders {
  + MapHeaders: map<string, string>
  + ArrayHeaders: List<any>
  --
  + UnmarshalYAML(unmarshal: fn): error
}
}
package "EXP与AI-EXP" {
class "ExpVerifyInfo" as ExpVerifyInfo {
  + MatchedSteps: int
  + LastStatus: int
  + Usage: string
  + Suggestion: string
}
class "ExpSpec" as ExpSpec {
  + Name: string
  + Steps: List<ExpStep>
  + ExploitSuggestion: string
}
class "ExpStep" as ExpStep {
  + Method: string
  + Path: string
  + Body: string
  + Headers: map<string, string>
  + Validate: Validation
  + Extract: map<string, ExtractRule>
  + Retry: int
  + RetryDelayMs: int
  + SleepMs: int
}
class "Validation" as Validation {
  + Status: StatusList
  + BodyContains: List<string>
  + HeaderContains: map<string, string>
}
class "StatusList" as StatusList {
  + UnmarshalJSON(data: bytes): error
  + UnmarshalYAML(unmarshal: fn): error
}
class "ExtractRule" as ExtractRule {
  + BodyRegex: List<string>
  + HeaderRegex: map<string, string>
}
class "ExpVerifyConfig" as ExpVerifyConfig {
  + TargetURL: string
  + ExpSpec: ExpSpec
  + PythonCode: string
  + Category: VulnCategory
  + MaxRetries: int
  + TimeoutSec: int
}
class "ExpVerifyResult" as ExpVerifyResult {
  + Success: bool
  + Output: string
  + Error: string
  + Matched: bool
  + CanExtract: bool
  + ExtractDemo: string
}
}
package "MCP接口 / JADX" {
interface "MCPConnection" as MCPConnection {
  + IsConnected(): bool
  + GetTools(): List<AITool>
  + CallTool(name: string, arguments: map<string, any>): tuple<any, error>
}
interface "ChatSession" as ChatSession {
  + GetID(): string
  + GetAPIKey(): string
  + GetAPIType(): string
  + GetMessages(): List<ChatMessage>
  + GetMCPConnection(): MCPConnection
  + SetMessages(messages: List<ChatMessage>): void
  + AddMessage(msg: ChatMessage): void
  + GetLastActivity(): time.Time
  + UpdateLastActivity(): void
}
class "BaseChatSession" as BaseChatSession {
  - mu: sync.RWMutex
  + ID: string
  + APIKey: string
  + APIType: string
  + Messages: List<ChatMessage>
  + MCPConnection: MCPConnection
  + CreatedAt: time.Time
  + LastActivity: time.Time
  --
  + GetID(): string
  + GetAPIKey(): string
  + GetAPIType(): string
  + GetMessages(): List<ChatMessage>
  + GetMCPConnection(): MCPConnection
  + SetMessages(messages: List<ChatMessage>): void
  + AddMessage(msg: ChatMessage): void
  + GetLastActivity(): time.Time
  + UpdateLastActivity(): void
}
class "JADXMCPConnection" as JADXMCPConnection {
  - mu: sync.RWMutex
  - baseURL: string
  - client: *http.Client
  - connected: bool
  - tools: List<MCPTool>
  - lastRequestID: int64
  - sessionID: string
  --
  - initialize(): error
  - listTools(): tuple<List<MCPTool>, error>
  + SendMCPRequest(method: string, params: map<string, any>): tuple<map<string, any>, error>
  + CallTool(toolName: string, arguments: map<string, any>): tuple<any, error>
  + GetTools(): List<AITool>
  + IsConnected(): bool
  + Close(): error
}
class "JADXChatSession" as JADXChatSession {
  + GetOrCreateJADXSession(sessionID: string): *JADXChatSession
  + CleanupOldJADXSessions(maxAge: time.Duration): void
}
class "MCPTool" as MCPTool {
  + Name: string
  + Description: string
  + Parameters: map<string, any>
}
}

Task "1" --> "0..*" SSEMessage : emits
ExpExecReq "1" ..> "0..*" ExpSpec : InlineExps
AIGenPythonFromExpReq "1" --> "1" ExpSpec : Exp
AIGenPythonFromExpReq "1" ..> "0..1" ExpVerifyInfo : optional Verify
AIGenPythonFromExpBatchReq "1" ..> "0..*" ExpSpec : InlineExps
XRPOC "1" *-- "1" XRInfo : contains
XRPOC "1" *-- "1..*" XRRule : rules
XRRule "1" *-- "1" XRRequest : request
NucleiPOC "1" *-- "1" NucleiInfo : info
NucleiPOC "1" *-- "1..*" NucleiRequest : requests
NucleiPOC "1" *-- "0..*" NucleiMatcher : top-level matchers
NucleiRequest "1" *-- "0..*" NucleiMatcher : request matchers
NucleiHeaders "1" ..> "0..*" NucleiRequest : header parsing helper
ExpSpec "1" *-- "1..*" ExpStep : steps
ExpStep "1" *-- "1" Validation : validate
ExpStep "1" *-- "0..*" ExtractRule : extract rules
Validation "1" *-- "1" StatusList : status
ExpVerifyConfig "1" --> "1" ExpSpec : ExpSpec
ExpVerifyConfig "1" ..> "1" ExpVerifyResult : verifyExp returns
BaseChatSession <|.. ChatSession : implements
JADXChatSession <|-- BaseChatSession : embedding/generalization
JADXMCPConnection <|.. MCPConnection : implements
BaseChatSession "1" *-- "0..*" ChatMessage : Messages
BaseChatSession "1" --> "0..1" MCPConnection : MCPConnection
JADXMCPConnection "1" *-- "0..*" MCPTool : tools cache

newpage

title NeonScan 2.0 补充类图
top to bottom direction
hide empty members
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam packageStyle rectangle
package "AI提供者" {
class "ChatMessage" as ChatMessage {
  + Role: string
  + Content: string
  + Time: string
  + ToolCallID: string
  + ToolCalls: List<AIToolCall>
}
interface "AIProvider" as AIProvider {
  + Chat(messages: List<ChatMessage>, tools: List<AITool>): tuple<string, List<AIToolCall>, error>
}
interface "ChatStreamProvider" as ChatStreamProvider {
  + ChatStream(messages: List<ChatMessage>, tools: List<AITool>, controller: *StreamController): tuple<string, List<AIToolCall>, error>
}
class "AITool" as AITool {
  + Type: string
  + Name: string
  + Description: string
  + Parameters: map<string, any>
}
class "AIToolCall" as AIToolCall {
  + ID: string
  + Name: string
  + Arguments: map<string, any>
}
class "OpenAIProvider" as OpenAIProvider {
  + APIKey: string
  + BaseURL: string
  + Model: string
  + MaxTokens: int
  + Timeout: time.Duration
  --
  + SetTimeout(timeout: time.Duration): void
  + Chat(messages: List<ChatMessage>, tools: List<AITool>): tuple<string, List<AIToolCall>, error>
  + ChatStream(messages: List<ChatMessage>, tools: List<AITool>, controller: *StreamController): tuple<string, List<AIToolCall>, error>
}
class "DeepSeekProvider" as DeepSeekProvider {
  + APIKey: string
  + BaseURL: string
  + Model: string
  + MaxTokens: int
  + Timeout: time.Duration
  --
  + SetTimeout(timeout: time.Duration): void
  + Chat(messages: List<ChatMessage>, tools: List<AITool>): tuple<string, List<AIToolCall>, error>
  + ChatStream(messages: List<ChatMessage>, tools: List<AITool>, controller: *StreamController): tuple<string, List<AIToolCall>, error>
}
class "AnthropicProvider" as AnthropicProvider {
  + APIKey: string
  + BaseURL: string
  + Model: string
  + MaxTokens: int
  + Timeout: time.Duration
  --
  + SetTimeout(timeout: time.Duration): void
  + Chat(messages: List<ChatMessage>, tools: List<AITool>): tuple<string, List<AIToolCall>, error>
}
class "OllamaProvider" as OllamaProvider {
  + APIKey: string
  + BaseURL: string
  + Model: string
  + MaxTokens: int
  + Timeout: time.Duration
  --
  + SetTimeout(timeout: time.Duration): void
  + Chat(messages: List<ChatMessage>, tools: List<AITool>): tuple<string, List<AIToolCall>, error>
  + ChatStream(messages: List<ChatMessage>, tools: List<AITool>, controller: *StreamController): tuple<string, List<AIToolCall>, error>
}
class "StreamController" as StreamController {
  - mu: sync.RWMutex
  - aborted: bool
  - abortChan: chan struct
  - messageChan: chan string
  --
  + Abort(): void
  + IsAborted(): bool
  + Send(message: string): bool
  + GetMessageChan(): recv-chan string
  + GetAbortChan(): recv-chan struct
}
}
package "WAF与其他辅助类型" {
class "WAFBypassReq" as WAFBypassReq {
  + BaseURL: string
  + Path: string
  + Payloads: List<string>
  + Methods: List<string>
  + Strategies: List<string>
  + Match: string
  + Concurrency: int
  + TimeoutMs: int
  + PayloadType: PayloadType
}
class "PayloadVariant" as PayloadVariant {
  + Variant: string
  + Strategies: List<string>
}
class "FingerprintRule" as FingerprintRule {
  + CMS: string
  + Method: string
  + Location: string
  + Keyword: List<string>
}
class "FingerprintData" as FingerprintData {
  + Fingerprint: List<FingerprintRule>
}
class "DictInfo" as DictInfo {
  + Name: string
  + Path: string
  + Category: string
}
}

ChatMessage "1" *-- "0..*" AIToolCall : ToolCalls
OpenAIProvider <|.. AIProvider : implements
DeepSeekProvider <|.. AIProvider : implements
AnthropicProvider <|.. AIProvider : implements
OllamaProvider <|.. AIProvider : implements
OpenAIProvider <|.. ChatStreamProvider : implements
DeepSeekProvider <|.. ChatStreamProvider : implements
OllamaProvider <|.. ChatStreamProvider : implements
ChatStreamProvider "1" ..> "1" StreamController : ChatStream controller
AIProvider "1" ..> "0..*" ChatMessage : input messages
AIProvider "1" ..> "0..*" AITool : available tools
AIProvider "1" ..> "0..*" AIToolCall : returns tool calls
WAFBypassReq "1" ..> "0..*" PayloadVariant : produces variants during bypass generation
FingerprintData "1" *-- "0..*" FingerprintRule : Fingerprint
@enduml
